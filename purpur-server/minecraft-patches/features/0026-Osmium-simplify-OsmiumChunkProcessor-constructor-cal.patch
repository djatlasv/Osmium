@@ -914,7 +914,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
         this.entityLookup = new ca.spottedleaf.moonrise.patches.chunk_system.level.entity.dfl.DefaultEntityLookup(this); // Paper - rewrite chunk system
         // Paper - Anti-Xray // Osmium start - wrap with OsmiumChunkProcessor
         io.papermc.paper.antixray.ChunkPacketBlockController paperController = this.paperConfig().anticheat.antiXray.enabled ? new io.papermc.paper.antixray.ChunkPacketBlockControllerAntiXray(this, executor) : io.papermc.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE;
