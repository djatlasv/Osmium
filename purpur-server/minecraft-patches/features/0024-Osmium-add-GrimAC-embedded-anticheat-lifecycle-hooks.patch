From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Djatlasv <djatlasv@users.noreply.github.com>
Date: Fri, 13 Mar 2026 15:29:51 -0600
Subject: [PATCH] Osmium: add GrimAC embedded anticheat lifecycle hooks


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index a07c897c2501998a9a5ccf4e8b317a7d502db499..6c623029e2604f8bee684848e1927cf34c4bb1f7 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -638,6 +638,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
         // Paper end - Configurable player collision; Handle collideRule team for player collision toggle
         this.server.enablePlugins(org.bukkit.plugin.PluginLoadOrder.POSTWORLD);
+        if (org.osmium.OsmiumConfig.grimEnabled) { org.osmium.anticheat.grim.OsmiumGrimLoader.start(); } // Osmium - GrimAC
         this.server.spark.registerCommandBeforePlugins(this.server); // Paper - spark
         this.server.spark.enableAfterPlugins(this.server); // Paper - spark
         if (io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper != null) io.papermc.paper.plugin.PluginInitializerManager.instance().pluginRemapper.pluginsEnabled(); // Paper - Remap plugins
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index b28d7a9fe0d5959e13b4d4a5c17365208c28ca53..eb47e675fe7fcea022e049f1d57c7f4d10f300c5 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -269,6 +269,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
         org.osmium.OsmiumConfig.init((java.io.File) options.valueOf("osmium-settings")); // Osmium
         org.osmium.anticheat.OsmiumAltTracker.init(new java.io.File(".")); // Osmium - alt ban IP tracking
         org.osmium.anticheat.OsmiumChatFilter.init(new java.io.File(".")); // Osmium - chat filter
+        if (org.osmium.OsmiumConfig.grimEnabled) { org.osmium.anticheat.grim.OsmiumGrimLoader.init(); } // Osmium - GrimAC
         // Purpur end - Migrate Setting to reintroduce end void rings
         // Paper start - initialize global and world-defaults configuration
         this.paperConfigurations.initializeGlobalConfiguration(this.registryAccess());
@@ -954,6 +955,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
 
     @Override
     public void stopServer() {
+        if (org.osmium.OsmiumConfig.grimEnabled) { org.osmium.anticheat.grim.OsmiumGrimLoader.stop(); } // Osmium - GrimAC
         org.osmium.anticheat.OsmiumDiscordWebhook.sendServerStop(); // Osmium - discord webhook (sync, before shutdown)
         this.notificationManager().serverShuttingDown();
         super.stopServer();
