diff --git a/net/minecraft/server/commands/BanPlayerCommands.java b/net/minecraft/server/commands/BanPlayerCommands.java
index 978ef2e996a78e907f959bfe99d47de832427011..f6d35a0e56cadacd0076278bb9675c1f9b8d3c16 100644
--- a/net/minecraft/server/commands/BanPlayerCommands.java
+++ b/net/minecraft/server/commands/BanPlayerCommands.java
@@ -52,6 +52,13 @@ public class BanPlayerCommands {
                 );
                 bans.add(userBanListEntry);
                 i++;
+                // Osmium start - discord webhook for bans
+                org.osmium.anticheat.OsmiumDiscordWebhook.sendBan(
+                    nameAndId.name(), nameAndId.id(),
+                    reason == null ? null : reason.getString(),
+                    source.getTextName()
+                );
+                // Osmium end - discord webhook for bans
                 source.sendSuccess(
                     () -> Component.translatable("commands.ban.success", Component.literal(nameAndId.name()), userBanListEntry.getReasonMessage()), true
                 );
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
