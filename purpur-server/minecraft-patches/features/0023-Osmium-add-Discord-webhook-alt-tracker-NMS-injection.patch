             if (org.purpurmc.purpur.PurpurConfig.beeCountPayload) org.purpurmc.purpur.task.BeehiveTask.instance().register(); // Purpur - Give bee counts in beehives to Purpur clients
 
             this.notificationManager().serverStarted();
+            org.osmium.anticheat.OsmiumDiscordWebhook.sendServerStart(); // Osmium - discord webhook
             return true;
         }
     }
@@ -953,6 +954,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
 
     @Override
     public void stopServer() {
+        org.osmium.anticheat.OsmiumDiscordWebhook.sendServerStop(); // Osmium - discord webhook (sync, before shutdown)
         this.notificationManager().serverShuttingDown();
         super.stopServer();
         //Util.shutdownExecutors(); // Paper - Improved watchdog support; moved into super
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 61c7d3a99da1cc32cb0eced0c524a5fb24a64b18..c599ad4f65886c525b84bc000ec3d575ef5254ed 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -2667,6 +2667,7 @@ public class ServerGamePacketListenerImpl
         String filterMatch = org.osmium.anticheat.OsmiumChatFilter.check(rawMessage);
         if (filterMatch != null) {
             String action = org.osmium.anticheat.OsmiumChatFilter.getAction();
+            org.osmium.anticheat.OsmiumDiscordWebhook.sendChatFiltered(this.player.getPlainTextName(), rawMessage, filterMatch, action); // Osmium - discord webhook
             if ("kick".equals(action)) {
                 this.disconnect(Component.literal(org.osmium.OsmiumConfig.chatFilterMessage), org.bukkit.event.player.PlayerKickEvent.Cause.ILLEGAL_CHARACTERS);
             } else {
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 7a9a37a630ea68328512c1a80bdaaefdd2253b9c..1a7515219b135005e706b14fa835ad7ec7905446 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -240,6 +240,30 @@ public abstract class PlayerList {
         org.bukkit.event.player.PlayerJoinEvent playerJoinEvent = new org.bukkit.event.player.PlayerJoinEvent(bukkitPlayer, io.papermc.paper.adventure.PaperAdventure.asAdventure(mutableComponent)); // Paper - Adventure
         this.cserver.getPluginManager().callEvent(playerJoinEvent);
 
+        // Osmium start - alt tracker: record join and check for banned alts
+        if (connection.getRemoteAddress() instanceof java.net.InetSocketAddress inetAddr) {
+            String ip = inetAddr.getAddress().getHostAddress();
+            org.osmium.anticheat.OsmiumAltTracker.recordJoin(ip, player.getUUID());
+            if (org.osmium.OsmiumConfig.altBanEnabled) {
+                java.util.Set<java.util.UUID> linkedUuids = org.osmium.anticheat.OsmiumAltTracker.getUuidsForIp(ip);
+                for (java.util.UUID linkedUuid : linkedUuids) {
+                    if (!linkedUuid.equals(player.getUUID()) && this.bans.isBanned(new NameAndId(linkedUuid, ""))) {
+                        String bannedName = null;
+                        org.bukkit.OfflinePlayer offlineBanned = org.bukkit.Bukkit.getOfflinePlayer(linkedUuid);
+                        if (offlineBanned.getName() != null) bannedName = offlineBanned.getName();
+                        org.osmium.anticheat.OsmiumDiscordWebhook.sendAltKicked(player.getPlainTextName(), player.getUUID(), bannedName);
+                        player.connection.disconnect(Component.literal(org.osmium.OsmiumConfig.altBanKickMessage));
+                        return;
+                    }
+                }
+                // Notify if player shares IP with others (even if not banned)
+                if (linkedUuids.size() > 1) {
+                    org.osmium.anticheat.OsmiumDiscordWebhook.sendAltDetected(player.getPlainTextName(), player.getUUID(), ip, linkedUuids);
+                }
+            }
+        }
+        // Osmium end - alt tracker
+
         if (!player.connection.isAcceptingMessages()) {
             return;
         }
