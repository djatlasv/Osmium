+                osmiumPacks.add(new String[]{osmiumPack.namespace(), osmiumPack.id(), osmiumPack.version()});
+            }
+            // Store for play-phase version validation (ViaVersion-aware)
+            org.osmium.OsmiumIdentity.storeKnownPacks(this.gameProfile.id(),
